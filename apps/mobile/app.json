{
  "expo": {
    "name": "UniItalia",
    "slug": "uniitalia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniitalia.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00B8D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uniitalia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniItalia использует доступ к фото, чтобы сотрудники могли загружать фотографии и логотипы университетов.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "uniitalia",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "mdtbkal",
    "extra": {
      "eas": {
        "projectId": "fdc50a38-0db4-40f6-ab88-04b70bb18ea5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/fdc50a38-0db4-40f6-ab88-04b70bb18ea5"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
